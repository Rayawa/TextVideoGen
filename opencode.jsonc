{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "small_model": "deepseek/deepseek-v4-flash",
  "default_agent": "video-producer",
  "skills": {
    "paths": [
      ".agents/skills"
    ]
  },
  "plugin": [
    "./vendor/plugins/opencode-image-generation/src/index.ts"
  ],
  "mcp": {
    "voicebox": {
      "type": "remote",
      "url": "http://127.0.0.1:17493/mcp",
      "enabled": true,
      "headers": {
        "X-Voicebox-Client-Id": "opencode-videotextgen"
      }
    }
  },
  "permission": {
    "external_directory": {
      "*": "deny",
      "/Users/raychen/Movies/VideoTextGen/**": "allow"
    },
    "read": "allow",
    "edit": "allow",
    "skill": {
      "*": "deny",
      "video-pipeline": "allow",
      "jacky-illustration": "allow",
      "jacky-motion2-0-srt": "allow"
    },
    "image_generate": "allow",
    "voicebox_*": "allow",
    "bash": {
      "*": "allow",
      "pwd": "allow",
      "rg *": "allow",
      "find *": "allow",
      "node .agents/skills/jacky-motion2-0-srt/scripts/*": "allow"
    }
  },
  "watcher": {
    "ignore": [
      ".videoenv/**",
      "vendor/plugins/**/node_modules/**",
      "projects/**/renders/**",
      "projects/**/work/renders/**",
      "projects/**/tmp/**"
    ]
  }
}
