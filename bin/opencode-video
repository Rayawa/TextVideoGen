#!/bin/zsh
set -eu

PROJECT_ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
export VIDEOTEXTGEN_ROOT="$PROJECT_ROOT"
source "$PROJECT_ROOT/.videoenv/activate"
cd "$PROJECT_ROOT"

"$PROJECT_ROOT/bin/voicebox-video" ensure

OPENCODE_BIN="${OPENCODE_BIN:-/opt/homebrew/bin/opencode}"
if [ ! -x "$OPENCODE_BIN" ]; then
  echo "OpenCode executable not found: $OPENCODE_BIN" >&2
  exit 1
fi

case "${1:-}" in
  run)
    shift
    exec "$OPENCODE_BIN" run --auto "$@"
    ;;
  mcp|debug|providers|models|agent|session|export|import|stats|db|completion|serve|web)
    exec "$OPENCODE_BIN" "$@"
    ;;
  *)
    exec "$OPENCODE_BIN" --auto "$@"
    ;;
esac
