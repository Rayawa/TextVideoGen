{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project.schema.json",
  "title": "Video Project State",
  "type": "object",
  "required": ["projectId", "title", "status", "createdAt", "artifacts", "renderHistory"],
  "properties": {
    "projectId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["draft", "running", "review", "revision", "approved", "blocked"]
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "sourceScript": { "type": ["string", "null"] },
    "artifacts": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/artifactRef" }
    },
    "renderHistory": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifactRef" }
    }
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "required": ["path", "version", "status"],
      "properties": {
        "path": { "type": "string" },
        "version": { "type": "string" },
        "status": { "type": "string" },
        "checksum": { "type": "string" },
        "inputs": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
