{
  "name": "video-text-gen",
  "version": "0.0.0",
  "private": true,
  "description": "Isolated OpenCode video production workspace.",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "opencode": "./bin/opencode-video",
    "voicebox:start": "./bin/voicebox-video start",
    "voicebox:status": "./bin/voicebox-video status",
    "voicebox:stop": "./bin/voicebox-video stop",
    "setup": "./bin/setup",
    "project:new": "node scripts/new-project.mjs",
    "log": "node scripts/log-event.mjs",
    "deliver": "node scripts/deliver-video.mjs",
    "pipeline": "echo \"Run ./bin/opencode-video to orchestrate the project workflow.\"",
    "env:check": "node scripts/check-environment.mjs",
    "runtime:link": "node scripts/link-runtime-binaries.mjs",
    "playwright:install": "playwright install chromium",
    "motion:validate": "node .agents/skills/jacky-motion2-0-srt/scripts/validate-motion-html.mjs",
    "motion:browser-check": "node .agents/skills/jacky-motion2-0-srt/scripts/check-layout-browser.mjs",
    "motion:content-check": "node scripts/check-semantic-motion.mjs",
    "test:motion": "node --test scripts/tests/semantic-motion.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && node scripts/check-environment.mjs && node scripts/check-voicebox.mjs"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "x-workspace-notes": [
    "Keep every project dependency and cache inside .videoenv or vendor.",
    "Run package commands only after sourcing .videoenv/activate."
  ]
}
